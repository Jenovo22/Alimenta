# Alimenta Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# AI/Gemini Configuration
# ============================================
# Gemini API Key for AI services
# Get your key from Google AI Studio
# This key is used ONLY by the backend - never exposed to frontend
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Custom API base URL (default: generativelanguage.googleapis.com)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# ============================================
# Security Tokens
# ============================================
# Optional auth token for documentation (docs/redoc)
# If set, Bearer token is required to access /docs and /redoc
# ALIMENTA_BETA_TOKEN=your_beta_token_here

# Auth token for Prometheus metrics endpoint
# PROMETHEUS_TOKEN=your_prometheus_token

# ============================================
# Cache & Redis Configuration
# ============================================
# Redis connection URL (default points to localhost)
REDIS_URL=redis://localhost:6379/0

# Cache time-to-live in seconds for catalog read endpoints
CACHE_TTL=3600

# ============================================
# Database Configuration
# ============================================
# SQLite database URLs (optional, defaults provided)
# DONATIONS_DB_URL=sqlite:///./donations.db
# DATABASE_URL=sqlite:///./feature_flags.db

# ============================================
# Notes
# ============================================
# - Never commit .env to version control
# - .env is already in .gitignore
# - In production, use environment variables or secrets management
# - API keys should be restricted by IP and service in Google Cloud Console
