# Environment variables example for Alimenta backend

# Redis connection URL (default points to localhost)
REDIS_URL=redis://localhost:6379/0

# Cache time-to-live in seconds for catalog read endpoints
CACHE_TTL=3600

# Google AI Studio / Gemini configuration (set real key only in .env or secret manager, never commit)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
